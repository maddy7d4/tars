{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run TARS Extension",
      "type": "extensionHost",
      "request": "launch",
      "preLaunchTask": "build",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}/packages/extension"],
      "outFiles": ["${workspaceFolder}/packages/extension/dist/**/*.js"],
      "sourceMaps": true
    }
  ]
}
