{
  "name": "tars",
  "displayName": "TARS",
  "description": "AI engineering agent for VS Code, Cursor and VSCodium \u2014 powered by the Claude Agent SDK.",
  "publisher": "maddy7d4",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "AI",
    "Programming Languages",
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onView:tars.chat"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "tars",
          "title": "TARS",
          "icon": "dist/media/tars.svg"
        }
      ]
    },
    "views": {
      "tars": [
        {
          "id": "tars.chat",
          "name": "Chat",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "tars.openChat",
        "title": "TARS: Open Chat"
      },
      {
        "command": "tars.newSession",
        "title": "TARS: New Session"
      },
      {
        "command": "tars.interrupt",
        "title": "TARS: Stop"
      },
      {
        "command": "tars.restoreCheckpoint",
        "title": "TARS: Restore a Checkpoint"
      },
      {
        "command": "tars.acceptHunk",
        "title": "TARS: Accept This Change"
      },
      {
        "command": "tars.rejectHunk",
        "title": "TARS: Reject This Change"
      },
      {
        "command": "tars.acceptFile",
        "title": "TARS: Accept All Changes in File"
      },
      {
        "command": "tars.rejectFile",
        "title": "TARS: Reject All Changes in File"
      },
      {
        "command": "tars.openFullDiff",
        "title": "TARS: Open Full Diff"
      },
      {
        "command": "tars.showMemory",
        "title": "TARS: Show Workspace Memory"
      },
      {
        "command": "tars.clearMemory",
        "title": "TARS: Clear Workspace Memory"
      },
      {
        "command": "tars.resumeSession",
        "title": "TARS: Resume a Conversation"
      }
    ],
    "keybindings": [
      {
        "command": "tars.openChat",
        "key": "ctrl+alt+a",
        "mac": "cmd+alt+a"
      }
    ],
    "configuration": {
      "title": "TARS",
      "properties": {
        "tars.permissionPolicy": {
          "type": "string",
          "enum": [
            "always_allow",
            "ask",
            "deny"
          ],
          "enumDescriptions": [
            "Run gated tools without asking. Only appropriate in a disposable workspace.",
            "Ask before every gated tool invocation.",
            "Deny every gated tool invocation and tell the model why."
          ],
          "default": "ask",
          "markdownDescription": "Default decision for tool invocations that require approval. Credentials are never configured here \u2014 the Agent SDK resolves them from the environment or an existing `claude` login (see `Docs/TARS_SPEC.md` \u00a71.3)."
        },
        "tars.toolPermissions": {
          "type": "object",
          "default": {},
          "additionalProperties": {
            "type": "string",
            "enum": [
              "always_allow",
              "ask",
              "deny"
            ]
          },
          "markdownDescription": "Per-tool overrides for `#tars.permissionPolicy#`, keyed by tool name \u2014 for example `{ \"Bash\": \"deny\" }`. An entry is a direct instruction and wins over both the default and the built-in gating of destructive and outward-facing tools (see `Docs/TARS_SPEC.md` \u00a74.2)."
        },
        "tars.review.openEditedFiles": {
          "type": "boolean",
          "default": true,
          "description": "Bring a file forward when TARS edits it, so its changes are visible for review. Turn off if you prefer to open edited files yourself from the chat panel."
        },
        "tars.mcpServers": {
          "type": "object",
          "default": {},
          "markdownDescription": "MCP servers the agent may use, keyed by name. Every tool an MCP server exposes is permission-gated as a class: configuring a server says it may run, not that it may run unattended.",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "transport": {
                "type": "string",
                "enum": [
                  "stdio",
                  "http",
                  "sse"
                ],
                "default": "stdio",
                "description": "How to reach the server. Defaults to stdio, which is what locally-installed servers use."
              },
              "command": {
                "type": "string",
                "description": "Executable to launch (stdio only)."
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Arguments for the command (stdio only)."
              },
              "env": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                },
                "description": "Extra environment for the command (stdio only)."
              },
              "url": {
                "type": "string",
                "description": "Server URL (http and sse only)."
              },
              "headers": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                },
                "description": "Extra request headers (http and sse only)."
              }
            }
          }
        }
      }
    },
    "menus": {
      "commandPalette": [
        {
          "command": "tars.acceptHunk",
          "when": "false"
        },
        {
          "command": "tars.rejectHunk",
          "when": "false"
        },
        {
          "command": "tars.acceptFile",
          "when": "false"
        },
        {
          "command": "tars.rejectFile",
          "when": "false"
        },
        {
          "command": "tars.openFullDiff",
          "when": "false"
        }
      ]
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc -b",
    "clean": "rm -rf dist out *.tsbuildinfo *.vsix",
    "test": "node esbuild.test.mjs && node out/test/run-tests.cjs",
    "package": "vsce package --no-dependencies",
    "build:tests": "node esbuild.test.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.220",
    "@tars/core": "workspace:*",
    "@tars/host": "workspace:*",
    "@tars/shared": "workspace:*"
  },
  "devDependencies": {
    "@tars/webview-ui": "workspace:*",
    "@types/mocha": "^10.0.10",
    "@types/vscode": "^1.90.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "mocha": "^11.8.0"
  },
  "keywords": [
    "ai",
    "agent",
    "claude",
    "anthropic",
    "chat",
    "refactor",
    "copilot",
    "cursor"
  ],
  "galleryBanner": {
    "color": "#1e1e1e",
    "theme": "dark"
  },
  "icon": "dist/media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/maddy7d4/tars.git"
  },
  "bugs": {
    "url": "https://github.com/maddy7d4/tars/issues"
  },
  "homepage": "https://github.com/maddy7d4/tars#readme"
}
