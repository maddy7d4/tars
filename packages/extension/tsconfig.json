{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    // esbuild owns `dist/` — it writes the single CommonJS bundle VS Code loads.
    // tsc is typecheck-only here, so its output goes to `out/`, which cannot
    // collide and is already lint- and git-ignored.
    "outDir": "out",
    "types": ["node", "vscode"]
  },
  "include": ["src/**/*.ts"],
  "references": [{ "path": "../shared" }, { "path": "../core" }, { "path": "../host" }]
}
